# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Scala source files
*.scala text eol=lf
*.sbt   text eol=lf
*.sc    text eol=lf

# Web assets
*.html  text eol=lf
*.css   text eol=lf
*.js    text eol=lf
*.ts    text eol=lf
*.json  text eol=lf

# Markdown / docs
*.md    text eol=lf
*.txt   text eol=lf

# Shell / PowerShell scripts
*.sh    text eol=lf
*.ps1   text eol=crlf

# Config files
*.xml   text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.toml  text eol=lf
*.conf  text eol=lf
*.properties text eol=lf

# Images — treat as binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.svg   text eol=lf
*.ico   binary
*.webp  binary

# Archives
*.zip   binary
*.tar   binary
*.gz    binary
*.jar   binary
